# Copy to `.dev.vars` (gitignored). Used by OpenNext / Wrangler local dev (`npm run dev`).
# Top-level wrangler.jsonc sets WE_MET_ENV=production; local dev needs local for localhost card lookup.

WE_MET_ENV=local

# Any random string works locally (details-step token signing).
WE_MET_TOKEN_SECRET=

# No Turnstile secret needed locally: WE_MET_ENV=local uses the always-pass verifier.

# Follow-up email consumer (local queue consumer / integration tests):
# GMAIL_SERVICE_ACCOUNT_JSON=
# GMAIL_SENDER=
# WE_MET_OWNER_FROM_EMAIL=
# WE_MET_TEST_MAIL_TO=
