{
  "name": "we-met",
  "version": "0.0.0",
  "private": true,
  "description": "We Met — digital business cards on Cloudflare Workers.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run email-templates:check && npm run test && npm run theme-colors && npm run build && npm run worker:dry-run && npm run worker:dry-run:generated && npm run worker:consumer-dry-run:nonprod && npm run worker:consumer-dry-run:production && npm run consumer-email-bundle:check && npm run deploy:guards && npm run secrets && npm run secret-usage && npm run actions-policy-workflows && npm run placeholders && npm run attribution",
    "email-templates:generate": "node scripts/generate-email-templates.mjs",
    "email-templates:check": "node scripts/check-email-templates-generated.mjs",
    "consumer-email-bundle:check": "node scripts/check-consumer-email-bundle.mjs",
    "theme-colors": "node scripts/check-theme-colors.mjs",
    "dev": "next dev --turbopack",
    "next:build": "next build",
    "build": "opennextjs-cloudflare build",
    "worker:dry-run": "wrangler deploy --dry-run",
    "worker:dry-run:generated": "node scripts/dry-run-generated-config.mjs",
    "worker:consumer-dry-run:nonprod": "wrangler deploy --dry-run --config workers/we-met-followup-email-consumer/wrangler.nonprod.jsonc",
    "worker:consumer-dry-run:production": "wrangler deploy --dry-run --config workers/we-met-followup-email-consumer/wrangler.production.jsonc",
    "deploy:guards": "node scripts/check-deploy-guards.mjs --target preview --config wrangler.jsonc && node scripts/check-deploy-guards.mjs --target production --config wrangler.jsonc && node scripts/check-deploy-guards.mjs --target consumer-nonprod --config workers/we-met-followup-email-consumer/wrangler.nonprod.jsonc && node scripts/check-deploy-guards.mjs --target consumer-production --config workers/we-met-followup-email-consumer/wrangler.production.jsonc",
    "db:migrate": "node scripts/apply-migrations.mjs --local",
    "db:migrate:remote": "node scripts/apply-migrations.mjs --remote we-met-db-nonprod",
    "cards:load": "tsx scripts/load-cards.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets": "secretlint \"**/*\"",
    "secret-usage": "node scripts/check-secret-usage.mjs",
    "actions-policy-workflows": "node scripts/check-actions-policy-workflows.mjs",
    "placeholders": "node scripts/check-placeholders.mjs",
    "attribution": "node scripts/check-attribution.mjs",
    "init-project": "node scripts/init-project.mjs",
    "repo-settings": "node scripts/repo-settings.mjs",
    "verify-action-pins": "node scripts/verify-action-pins.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.2",
    "@opennextjs/cloudflare": "^1.20.6",
    "next": "^15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "10.2.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "secretlint": "10.2.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.7",
    "wrangler": "^4.149.0"
  }
}
