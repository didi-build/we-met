{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "we-met-followup-email-consumer",
  "workers_dev": false,
  "preview_urls": false,
  "main": "index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    "WE_MET_ENV": "production",
    "WE_MET_BASE_URL": "https://we-met.link",
  },
  "d1_databases": [
    {
      "binding": "WE_MET_DB",
      "database_name": "we-met-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "r2_buckets": [
    {
      "binding": "WE_MET_ASSETS",
      "bucket_name": "we-met-assets",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@mail.we-met.link"],
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "we-met-followup-email",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 30,
        "retry_delay": 30,
      },
    ],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": true },
  },
}
