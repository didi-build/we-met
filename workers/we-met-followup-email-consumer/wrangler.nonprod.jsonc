{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "we-met-followup-email-consumer-nonprod",
  "workers_dev": false,
  "preview_urls": false,
  "main": "index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    "WE_MET_ENV": "preview",
    "WE_MET_BASE_URL": "https://we-met.link",
  },
  "d1_databases": [
    {
      "binding": "WE_MET_DB",
      "database_name": "we-met-db-nonprod",
      "database_id": "00000000-0000-0000-0000-000000000002",
    },
  ],
  "r2_buckets": [
    {
      "binding": "WE_MET_ASSETS",
      "bucket_name": "we-met-assets-nonprod",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "we-met-followup-email-nonprod",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 30,
        "retry_delay": 30,
      },
    ],
  },
}
