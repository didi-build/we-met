# Copy to `.env` for local development. Names only — never put real values in git.
# See docs/architecture/environments.md for each variable.

WE_MET_ENV=local
WE_MET_BASE_URL=
WE_MET_APP_ORIGIN=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# WE_MET_PREVIEW_LOGIN_SECRET=  # preview Worker secret only
# WE_MET_PREVIEW_LOGIN_EMAIL=    # preview base config var only
# Preview hostname suffix (e.g. -we-met-preview.<account-subdomain>.workers.dev); set in Wrangler preview vars.
WE_MET_PREVIEW_HOST_SUFFIX=
WE_MET_TOKEN_SECRET=

# Local: Cloudflare always-pass Turnstile test pair (see environments.md).
# Preview/production builds use different NEXT_PUBLIC_TURNSTILE_SITE_KEY at build time (DIDI-572).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

WE_MET_EMAIL_FROM_CLOUDFLARE=
WE_MET_FROM_DISPLAY_NAME=
WE_MET_TEST_MAIL_TO=
